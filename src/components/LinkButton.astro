---
export interface Props {
  href: string;
  className?: string;
  class?: string; // 🟢 新增：允許接受 class 屬性，這樣其他頁面就不會報錯了
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  target?: string; // ✅ 支援
  rel?: string;    // ✅ 支援
  id?: string;     // ✅ 保留你原本的 id
}

// [修正]：使用 ...rest 把剩下所有沒列出來的屬性 (包含 target, rel) 全部抓進來
const {
  href,
  className,
  ariaLabel,
  title,
  disabled = false,
  ...rest 
} = Astro.props;
---

{
  disabled ? (
    <span
      class:list={["group inline-block", className]}
      title={title}
      aria-disabled={disabled}
      {...rest} >
      <slot />
    </span>
  ) : (
    <a
      href={href}
      class:list={["group inline-block hover:text-skin-accent", className]}
      aria-label={ariaLabel}
      title={title}
      {...rest}       
    >
      <slot />
    </a>
  )
}