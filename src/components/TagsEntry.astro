---
import LinkButton from "./LinkButton.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<div class={`mx-auto flex max-w-app justify-center px-4 pb-8 ${noMarginTop ? "" : "mt-8"}`}>
  <LinkButton
    href="/tags"
    class="flex items-center gap-1 text-lg font-medium text-skin-accent underline decoration-brand-200 decoration-2 underline-offset-4 hover:text-brand-500"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
      <path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
      <path d="M6 9h-.01" />
    </svg>
    <span>標籤總覽</span>
  </LinkButton>
</div>
