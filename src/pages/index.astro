---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout ogImage="/hero-og.jpg">
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pb-6">
      <div class="relative overflow-hidden rounded-lg shadow-lg">
        <img
          src="/hero.jpg"
          srcset="/hero-1200.jpg 1200w, /hero.jpg 2400w"
          sizes="100vw"
          class="h-[52vw] w-full object-cover object-[center_30%] sm:h-[420px]"
          alt="馬可博士數位治理實驗室"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent"></div>
        <div class="absolute inset-0 flex flex-col justify-center px-6 sm:px-12">
          <h1 class="max-w-[16ch] text-4xl font-bold text-white drop-shadow-md sm:text-6xl">
            數位治理實驗室
          </h1>
          <p class="mt-3 max-w-[32ch] text-base text-white/90 drop-shadow sm:text-lg">
            探索 Web3、AI 與 ESG 的永續新共識。
          </p>
        </div>
      </div>
      <a
        target="_blank"
        href="/rss.xml"
        class="mt-4 inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div class="mt-6">
        <div>
          <h2 class="mt-4 text-lg font-medium leading-relaxed text-skin-secondary sm:mt-0 sm:text-xl">
            探索 Web3、AI 與 ESG 的永續新共識。
          </h2>
          <p>
            這是一個開放的「實驗室」。無論您是學生、開發者、研究者，還是關心未來的管理者和決策者，誠摯邀請您加入這場關於未來的對話與實驗。
          </p>
          <p class="mt-2">
            我是馬可博士。請前往
            <LinkButton
              className="underline decoration-dashed underline-offset-4 hover:text-accent"
              href="/about/"
            >
            我的頁面
            </LinkButton> 來關注我們的動態。
          </p>
          <p class="mt-2 text-sm text-skin-secondary">
            相關網站：
            <a href="https://drmarcolab.cloud/" target="_blank" rel="noopener noreferrer" class="underline decoration-dashed underline-offset-4 hover:text-accent">馬可博士數位治理工作室</a>
            ｜
            <a href="https://frontpage.com.tw/" target="_blank" rel="noopener noreferrer" class="underline decoration-dashed underline-offset-4 hover:text-accent">馬可博士新智講堂</a>
          </p>
          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">社群連結:</div>
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">精選</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">近期文章</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <LinkButton href="/posts/">
        所有觀察
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href="/notes/">
        所有筆記
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
