---
import { getCollection } from "astro:content";
import Tag from "./Tag.astro";
import Hr from "./Hr.astro";
import getUniqueTags from "@/utils/getUniqueTags";

const posts = await getCollection("blog");
const tags = getUniqueTags(posts);
---

<div class="my-8">
  <Hr />
</div>

<div class="mx-auto max-w-app px-4 pt-8">
  <h2 class="text-2xl font-semibold tracking-wide">所有標籤</h2>
  <div class="flex flex-wrap justify-center gap-2 py-8">
    {tags.map(({ tag, tagName }: any) => <Tag tag={tag} tagName={tagName} size="lg" />)}
  </div>
</div>
